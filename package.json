{
  "name": "dostigator",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build && node scripts/prepare-sites-build.mjs && node scripts/prepare-pages-build.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:postgres": "node tests/postgres/history.integration.mjs",
    "test:checks": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:proposal && pnpm test:release && pnpm test:postgres",
    "test:all": "pnpm test:checks && pnpm build",
    "preview": "vite preview",
    "dev:local": "vite --config tests/local-browser/vite.config.mjs",
    "test:proposal": "node --test proposals/program-v2/model.test.mjs proposals/program-v2/local-integration.test.mjs",
    "test:release": "node --test tests/build-release.integration.mjs",
    "test:browser:product": "node tests/browser/product-audit.mjs",
    "test:browser:secondary": "node tests/browser/secondary-audit.mjs",
    "test:browser:auth": "node --env-file=.env.audit.local tests/browser/real-auth-ui.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.34.0",
    "pdfmake": "0.3.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "0.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "embedded-postgres": "18.4.0-beta.17",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "playwright": "1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  }
}
